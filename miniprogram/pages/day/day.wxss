.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-arrow {
  font-size: 28rpx;
  color: #4A90D9;
}

.day-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.day-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.day-week {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
}

.events-list {
  padding: 0 8rpx;
}

.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #27AE60, #219A52);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(39, 174, 96, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}
