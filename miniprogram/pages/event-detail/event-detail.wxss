.detail-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.detail-header {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-category {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.category-text {
  font-size: 22rpx;
  color: #ffffff;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: #999;
  min-width: 160rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.action-buttons {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item.full {
  flex-direction: column;
  align-items: flex-start;
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  min-width: 140rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666;
}

.form-picker {
  font-size: 28rpx;
  color: #4A90D9;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}
