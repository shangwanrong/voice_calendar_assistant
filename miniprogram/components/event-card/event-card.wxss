.event-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-left {
  margin-right: 20rpx;
}

.category-bar {
  width: 8rpx;
  height: 80rpx;
  border-radius: 4rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-time {
  font-size: 24rpx;
  color: #666;
}

.card-reminder {
  font-size: 22rpx;
  color: #F39C12;
}

.card-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-actions {
  padding: 16rpx;
  margin-left: 8rpx;
}

.delete-btn {
  font-size: 36rpx;
}
