.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item.full {
  flex-direction: column;
  align-items: flex-start;
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  min-width: 140rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666;
}

.form-picker {
  font-size: 28rpx;
  color: #4A90D9;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.save-btn {
  margin-top: 40rpx;
  width: 100%;
}
